MONGODB_URI=mongodb://localhost:27017/daily-roadmap
JWT_SECRET=your-super-secret-jwt-key-change-this

ADMIN_USERNAME=admin
ADMIN_PIN=1234
# Optional. Attached to the first account so it can reset its PIN by email.
ADMIN_EMAIL=you@example.com

# Outbound email for PIN reset codes (Google SMTP by default).
# Gmail requires an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Daily Roadmap <you@gmail.com>"
