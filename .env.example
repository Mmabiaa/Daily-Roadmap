MONGODB_URI=mongodb://localhost:27017/daily-roadmap
JWT_SECRET=your-super-secret-jwt-key-change-this

ADMIN_USERNAME=admin
# Required to seed: 6–8 digits. The seed refuses to run without it, so the
# admin account is never created with a default PIN.
ADMIN_PIN=482915
# Optional. Attached to the first account so it can reset its PIN by email.
ADMIN_EMAIL=you@example.com

# Guards /api/seed. Call it with the `x-seed-key: <value>` header. When unset,
# seeding is disabled in production.
SEED_SECRET=change-this-to-a-long-random-value

# Outbound email for PIN reset codes (Google SMTP by default).
# Gmail requires an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Daily Roadmap <you@gmail.com>"
