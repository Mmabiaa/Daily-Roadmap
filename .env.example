# Must point at a replica set. The schedule's multi-document writes go through
# transactions, and MongoDB only serves those on a replica set member or a
# mongos. Atlas is one by default; a local mongod needs `replication.replSetName`
# set and `rs.initiate()` run once — see the README.
MONGODB_URI=mongodb://127.0.0.1:27017/daily-roadmap?replicaSet=rs0
JWT_SECRET=your-super-secret-jwt-key-change-this

ADMIN_USERNAME=admin
# Required to seed: 6–8 digits. The seed refuses to run without it, so the
# admin account is never created with a default PIN.
ADMIN_PIN=482915
# Optional. Attached to the first account so it can reset its PIN by email.
ADMIN_EMAIL=you@example.com
# Optional. IANA zone for the first account, so its "today" matches its own
# clock. Falls back to UTC. New sign-ups send their browser's zone instead.
ADMIN_TIMEZONE=Europe/London

# Guards /api/seed. Call it with the `x-seed-key: <value>` header. When unset,
# seeding is disabled in production.
SEED_SECRET=change-this-to-a-long-random-value

# Sign-in throttling. Leave TRUST_PROXY_HEADERS unset unless a proxy you control
# overwrites the header — otherwise a client could spoof its own IP. On Vercel,
# set it to `true`; x-forwarded-for is written by the platform.
# TRUST_PROXY_HEADERS=true
# TRUSTED_IP_HEADER=x-forwarded-for

# Outbound email: PIN reset codes and the welcome mail after sign-up (Google
# SMTP by default).
# Gmail requires an App Password: https://myaccount.google.com/apppasswords
# Keep SMTP_FROM on the account you authenticate as. Sending "as" an address
# that account does not own (an unverified alias) is accepted by Gmail with a
# 250 OK and then dropped on arrival, so the app reports success while no mail
# ever lands.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Daily Roadmap <you@gmail.com>"
